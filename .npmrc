# onnxruntime-node (dependency of @huggingface/transformers) postinstall internet se binary download karta hai
# aur CI me fail hota hai. App browser/Capacitor me chalta hai (onnxruntime-web), isliye scripts skip safe hain.
# Ye file har npm install pe apply hoti hai, chahe workflow purana ho.
ignore-scripts=true
audit=false
fund=false
fetch-retries=5
fetch-retry-mintimeout=2000
